											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"message": "Activities inside foreach loop failed in PL_Source_To_Silver_Main pipeline",
										"errorCode": "500"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
