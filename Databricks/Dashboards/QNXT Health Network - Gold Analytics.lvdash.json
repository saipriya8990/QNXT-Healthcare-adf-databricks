{
  "datasets": [
    {
      "name": "lab_trends",
      "displayName": "Lab Test Trends",
      "config": {
        "version": "1.1",
        "source": "adb_qnxthealth.gold.lab_test_trends",
        "dimensions": [
          {
            "name": "test_name",
            "expr": "test_name",
            "displayName": "Test Name"
          },
          {
            "name": "year",
            "expr": "year"
          },
          {
            "name": "month",
            "expr": "month"
          },
          {
            "name": "month_name",
            "expr": "month_name"
          },
          {
            "name": "quarter_name",
            "expr": "quarter_name"
          },
          {
            "name": "abnormal_rate_pct",
            "expr": "abnormal_rate_pct"
          },
          {
            "name": "critical_rate_pct",
            "expr": "critical_rate_pct"
          },
          {
            "name": "abnormal_rate_change_pct",
            "expr": "abnormal_rate_change_pct"
          },
          {
            "name": "year_month",
            "expr": "MAKE_DATE(year, month, 1)",
            "displayName": "Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Tests",
            "expr": "SUM(total_tests)"
          },
          {
            "name": "Abnormal Tests",
            "expr": "SUM(abnormal_test_count)"
          },
          {
            "name": "Critical Tests",
            "expr": "SUM(critical_test_count)"
          },
          {
            "name": "Avg Abnormal Rate Pct",
            "expr": "AVG(abnormal_rate_pct)",
            "displayName": "Avg Abnormal Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "Avg Critical Rate Pct",
            "expr": "AVG(critical_rate_pct)",
            "displayName": "Avg Critical Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "Avg Rate Change Pct",
            "expr": "AVG(abnormal_rate_change_pct)",
            "displayName": "Avg Abnormal Rate Change (pp)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "patient_360",
      "displayName": "Patient 360",
      "config": {
        "version": "1.1",
        "source": "adb_qnxthealth.gold.patient_360",
        "dimensions": [
          {
            "name": "patient_id",
            "expr": "patient_id"
          },
          {
            "name": "first_name",
            "expr": "first_name"
          },
          {
            "name": "last_name",
            "expr": "last_name"
          },
          {
            "name": "date_of_birth",
            "expr": "date_of_birth"
          },
          {
            "name": "age",
            "expr": "age"
          },
          {
            "name": "age_group",
            "expr": "CASE\n  WHEN age BETWEEN 0 AND 18 THEN '0-18'\n  WHEN age BETWEEN 19 AND 35 THEN '19-35'\n  WHEN age BETWEEN 36 AND 50 THEN '36-50'\n  WHEN age BETWEEN 51 AND 65 THEN '51-65'\n  ELSE '66+'\nEND",
            "displayName": "Age Group"
          },
          {
            "name": "gender",
            "expr": "gender"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "state",
            "expr": "state"
          },
          {
            "name": "hospital_id",
            "expr": "hospital_id"
          },
          {
            "name": "hospital_name",
            "expr": "hospital_name"
          },
          {
            "name": "insurance_provider_id",
            "expr": "insurance_provider_id"
          },
          {
            "name": "insurance_provider_name",
            "expr": "insurance_provider_name"
          },
          {
            "name": "total_tests",
            "expr": "total_tests"
          },
          {
            "name": "abnormal_test_count",
            "expr": "abnormal_test_count"
          },
          {
            "name": "critical_test_count",
            "expr": "critical_test_count"
          },
          {
            "name": "last_test_date",
            "expr": "last_test_date"
          },
          {
            "name": "has_tests",
            "expr": "CASE WHEN total_tests > 0 THEN 'Has Tests' ELSE 'No Tests' END",
            "displayName": "Test Status"
          }
        ],
        "measures": [
          {
            "name": "Patient Count",
            "expr": "COUNT(1)"
          },
          {
            "name": "Total Lab Tests",
            "expr": "SUM(total_tests)"
          },
          {
            "name": "Total Abnormal Tests",
            "expr": "SUM(abnormal_test_count)"
          },
          {
            "name": "Total Critical Tests",
            "expr": "SUM(critical_test_count)"
          },
          {
            "name": "Abnormal Rate Pct",
            "expr": "MEASURE(`Total Abnormal Tests`) * 100.0 / MEASURE(`Total Lab Tests`)",
            "displayName": "Abnormal Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "Hospital Count",
            "expr": "COUNT(DISTINCT hospital_name)"
          }
        ]
      }
    },
    {
      "name": "hospital_daily",
      "displayName": "Hospital Daily Summary",
      "config": {
        "version": "1.1",
        "source": "adb_qnxthealth.gold.hospital_daily_summary",
        "dimensions": [
          {
            "name": "hospital_id",
            "expr": "hospital_id"
          },
          {
            "name": "hospital_name",
            "expr": "hospital_name"
          },
          {
            "name": "summary_date",
            "expr": "summary_date",
            "displayName": "Date"
          },
          {
            "name": "day_name",
            "expr": "day_name"
          },
          {
            "name": "day_type",
            "expr": "CASE WHEN is_weekend = true THEN 'Weekend' ELSE 'Weekday' END",
            "displayName": "Day Type"
          }
        ],
        "measures": [
          {
            "name": "Total Tests",
            "expr": "SUM(total_tests)"
          },
          {
            "name": "Unique Patients Tested",
            "expr": "SUM(unique_patients_tested)"
          },
          {
            "name": "Active Doctors",
            "expr": "SUM(active_doctor_count)"
          },
          {
            "name": "Abnormal Tests",
            "expr": "SUM(abnormal_test_count)"
          },
          {
            "name": "Critical Tests",
            "expr": "SUM(critical_test_count)"
          },
          {
            "name": "Avg Abnormal Rate Pct",
            "expr": "AVG(abnormal_rate_pct)",
            "displayName": "Avg Abnormal Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "Avg Daily Tests",
            "expr": "AVG(total_tests)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "Day Count",
            "expr": "COUNT(1)"
          },
          {
            "name": "Avg Unique Patients Per Day",
            "expr": "AVG(unique_patients_tested)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    }
  ],
